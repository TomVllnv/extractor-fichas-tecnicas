# Solo para ajustar el puerto que utiliza Docker en el servidor (opcional).
# No es necesario crear un .env: estos ya son los valores predeterminados.
# Docker Compose carga .env automáticamente si TI decide utilizarlo.
# No guardar claves ni contraseñas reales en este archivo de ejemplo.
OCR_HOST=127.0.0.1
OCR_PORT=8501
